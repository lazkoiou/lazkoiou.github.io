---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">QA Automation Engineer</p>
      <h1>I build test automation that teams actually trust.</h1>
      <p class="lead">
        Playwright, TypeScript and CI pipelines that catch regressions early, run fast and stay maintainable.
      </p>
      <div class="actions">
        <a class="btn primary" href="/projects">Run a live test demo</a>
        <a class="btn" href="/contact">Get in touch</a>
      </div>
    </section>

    <section id="about">
      <h2>About</h2>
      <p>
        I'm a QA automation engineer who treats test code as production code: typed, reviewed, and designed for
        readability. I work across the stack, from UI and API flows to email and data validation, and partner closely
        with developers and product to shift quality left.
      </p>
      <p><em>Replace this paragraph with your own story.</em></p>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <div class="grid">
        <article class="card">
          <h3>Test automation</h3>
          <ul class="tags"><li>Playwright</li><li>TypeScript</li><li>Page Object Model</li><li>API testing</li></ul>
        </article>
        <article class="card">
          <h3>CI / CD</h3>
          <ul class="tags"><li>GitLab CI</li><li>GitHub Actions</li><li>Docker</li><li>Parallel sharding</li></ul>
        </article>
        <article class="card">
          <h3>Test management</h3>
          <ul class="tags"><li>TestRail</li><li>Jira</li><li>Regression strategy</li><li>Risk-based testing</li></ul>
        </article>
        <article class="card">
          <h3>Practices</h3>
          <ul class="tags"><li>Flaky test triage</li><li>Test data design</li><li>Code review</li><li>Exploratory testing</li></ul>
        </article>
      </div>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <ol class="timeline">
        <li>
          <h3>QA Automation Engineer <span>· Company name</span></h3>
          <p class="meta">20XX – Present</p>
          <p>Own the end-to-end automation suite, grow regression coverage and keep pipeline feedback under control.</p>
        </li>
        <li>
          <h3>QA Engineer <span>· Company name</span></h3>
          <p class="meta">20XX – 20XX</p>
          <p>Designed manual and automated test plans for web applications; introduced automation to the release process.</p>
        </li>
      </ol>
    </section>

    <section id="education">
      <h2>Education</h2>
      <ol class="timeline">
        <li>
          <h3>Degree / programme name <span>· University name</span></h3>
          <p class="meta">20XX – 20XX</p>
          <p>Relevant focus, thesis or achievements. <em>Replace with your own details.</em></p>
        </li>
        <li>
          <h3>Certification <span>· Issuer</span></h3>
          <p class="meta">20XX</p>
          <p>For example ISTQB Foundation Level.</p>
        </li>
      </ol>
    </section>
  </div>
</Base>
