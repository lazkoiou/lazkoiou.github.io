---
import Base from '../layouts/Base.astro';
---

<Base>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">QA Automation Engineer</p>
      <h1>I build test automation that teams actually trust.</h1>
      <p class="lead">
        Playwright, TypeScript and CI pipelines that catch regressions early, run fast and stay maintainable.
      </p>
      <div class="actions">
        <a class="btn primary" href="/projects">Run a live test demo</a>
        <a class="btn" href="/contact">Get in touch</a>
      </div>
    </section>

    <section id="about">
      <h2>About</h2>
      <p>
        I'm a QA automation engineer who treats test code as production code: typed, reviewed, and designed for
        readability. I work across the stack, from UI and API flows to email and data validation, and partner closely
        with developers and product to shift quality left.
      </p>
      <p><em>Replace this paragraph with your own story.</em></p>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <div class="grid">
        <article class="card">
          <h3>Test automation</h3>
          <ul class="tags"><li>Playwright</li><li>TypeScript</li><li>Selenium</li><li>Java</li><li>Page Object Model</li><li>API testing</li></ul>
        </article>
        <article class="card">
          <h3>Automation Practices</h3>
          <ul class="tags"><li>Flaky test triage</li><li>Code review</li><li>Debugging</li></ul>
        </article>
        <article class="card">
          <h3>AI</h3>
          <ul class="tags"><li>Claude</li><li>Cursor</li><li>Agentic workflows</li><li>Agentic coding</li><li>Vibe coding</li></ul>
        </article>
        <article class="card">
          <h3>CI / CD</h3>
          <ul class="tags"><li>GitLab</li><li>BitBucket</li><li>GitHub</li><li>Jenkins</li><li>Pipelines</li></ul>
        </article>
        <article class="card">
          <h3>Test management & strategy</h3>
          <ul class="tags"><li>TestRail</li><li>Jira</li><li>Regression strategy</li><li>Risk-based testing</li><li>Priorities</li><li>Criticality</li></ul>
        </article>
        <article class="card">
          <h3>Manual Testing</h3>
          <ul class="tags"><li>Shift testing left</li><li>Test data design</li><li>Exploratory testing</li></ul>
        </article>
      </div>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <ol class="timeline">
        <li>
          <h3>QA Lead Engineer / Head of QA</h3>
          <p class="meta"><b>2025 – Present</b></p>
          <p>Scalable test automation infrastructure built from scratch (Web & API) with Playwright and TypeScript.</p>
          <p>Critical test case coverage up to 70%.</p>
          <p>Built pipelines that can be trusted.</p>
          <p>Introduced Agentic coding and Agentic workflows with guardrails.</p>
          <p>Test strategy, priority and improvements of SDLC processes</p>
        </li>
        <li>
          <h3>Mid to Senior QA Engineer</h3>
          <p class="meta"><b>2021 – 2025</b></p>
          <p>Test automation for web applications with Selenium and Java</p>
          <p>Test automation for mobile applications with Appium utilizing BrowserStack</p>
        </li>
      </ol>
    </section>

    <section id="education">
      <h2>Education & Certifications</h2>
      <ol class="timeline">
        <li>
          <h4>ISTQB Certified Tester - Advanced Test Automation Engineer</h4>
          <p class="meta"><b>2023</b></p>
          <p><em>Issued by: GRTB</em></p>
        </li>
        <li>
          <h4>ISTQB Certified Tester - Foundation Level</h4>
          <p class="meta"><b>2022</b></p>
          <p><em>Issued by: GRTB</em></p>
        </li>
        <li>
          <h4>Software Quality Assurance - Testing</h4>
          <p class="meta"><b>2018</b></p>
          <p><em>Issued by: Code.Hub</em></p>
        </li>
        <li>
          <h3>Computer & Communication Engineering (Master's Degree - 300 ETCS)</h3>
          <p class="meta"><b>2017</b></p>
          <span>Department of Electrical and Computer Engineering, University of Thessaly</span>
          <p><em>Thesis: Spark-based algorithms for finding communities in multi-layer complex networks</em></p>
        </li>
      </ol>
    </section>
  </div>
</Base>
