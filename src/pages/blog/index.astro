---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allSeries, allTags, seriesChapters, slugify } from '../../lib/blog';

const posts = await getPosts();
const series = allSeries(posts);
const tags = allTags(posts);
---

<Base title="Blog" description="Writing about test automation, Playwright and quality engineering.">
  <div class="wrap">
    <div class="page-head">
      <h1>Blog</h1>
      <p>Notes on test automation, Playwright and building quality into the delivery pipeline.</p>
      <p class="meta"><a href="/rss.xml">RSS feed</a></p>
    </div>

    {series.length > 0 && (
      <section style="padding-top: 2rem">
        <h2>Series</h2>
        <div class="grid">
          {series.map((s) => (
            <a class="card" href={`/blog/series/${slugify(s)}/`}>
              <h3>{s}</h3>
              <p>{seriesChapters(posts, s).length} chapters</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {tags.length > 0 && (
      <ul class="tags" style="margin-top: 2rem">
        {tags.map((t) => <li><a href={`/blog/tags/${slugify(t)}/`}>#{t}</a></li>)}
      </ul>
    )}

    <section style="padding-top: 1rem">
      <h2>All posts</h2>
      <div class="post-list">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  </div>
</Base>
