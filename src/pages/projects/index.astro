---
import Base from '../../layouts/Base.astro';
import { demos } from '../../data/demos';
---

<Base title="Projects" description="Interactive Playwright test showcases: watch a test run, then read the report.">
  <div class="wrap">
    <div class="page-head">
      <h1>Projects</h1>
      <p>
        Each project is a real Playwright spec you can run in the browser. Press play to watch the test execute, follow
        the terminal output and explore the generated report.
      </p>
    </div>
    <section style="padding-top: 2rem">
      <div class="grid">
        {demos.map((d) => (
          <a class="card" href={`/projects/${d.id}`}>
            <h3>{d.title}</h3>
            <p>{d.summary}</p>
            <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>
            <span class="link">Run it →</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
